  "scripts": {
    "build": "rimraf dist && npx tsc && cpx \"src/seed/data/**/*\" dist/seed/data",
    "start": "npm run build && node dist/index.js",
    "dev": "concurrently \"npx tsc --watch\" \"npx nodemon dist/index.js\"",
    "seed": "npm run build && cp -R src/seed/data dist/seed/data && node dist/seed/seedDynamodb.js"
  },
